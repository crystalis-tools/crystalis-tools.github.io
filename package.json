{
  "name": "crystalis-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/selftest.mjs --log-level=warning && node node_modules/.tmp/selftest.mjs",
    "checkrom": "esbuild scripts/checkrom.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/checkrom.mjs --log-level=warning && node node_modules/.tmp/checkrom.mjs",
    "checksprites": "esbuild scripts/checksprites.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/checksprites.mjs --log-level=warning && node node_modules/.tmp/checksprites.mjs",
    "rendermap": "esbuild scripts/rendermap.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --outfile=node_modules/.tmp/rendermap.mjs --log-level=warning && node node_modules/.tmp/rendermap.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview": "^7.0.4",
    "dockview-react": "^7.0.4",
    "react": "^19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "zustand": "^5.0.14"
  }
}
